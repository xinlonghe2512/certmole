# ==========================================
# Line Endings Normalization
# ==========================================
# Handle text files automatically to convert CRLF to LF on commit
* text=auto

# Explicitly enforce Linux/Unix line endings (LF) for scripts and Makefiles
*.sh text eol=lf
Makefile text eol=lf

# ==========================================
# GitHub Linguistics & Highlighting
# ==========================================
# Ensure markdown documentation and configuration layouts are recognized as documentation
*.md text
.gitignore text
.gitattributes text